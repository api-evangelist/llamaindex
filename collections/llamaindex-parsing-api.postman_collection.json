          "id": "c84932c3-ed33-4f62-85b3-998533656873",
          "name": "Parse a document via file upload",
          "request": {
            "name": "Parse a document via file upload",
            "description": {
              "content": "Submit a document for parsing using multipart file upload. The file is uploaded directly along with parsing configuration. The tier parameter determines the parsing mode. Jobs are processed asynchronously and results are retrieved via the job status endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "parse",
                "upload"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The document file to upload and parse."
                },
                {
                  "key": "configuration",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) JSON string containing the parsing configuration including tier, version, and other options."
                }
              ]
