          "name": "Parse a document",
          "request": {
            "name": "Parse a document",
            "description": {
              "content": "Submit a document for parsing using a JSON request body. Accepts either a file_id referencing a previously uploaded file or a source_url to fetch the document from. Exactly one of file_id or source_url must be provided. The tier parameter determines the parsing mode. Jobs are processed asynchronously and results are retrieved via the job status endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "parse"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
