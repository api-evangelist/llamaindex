          "id": "c97c1c23-fd94-467d-b31f-b58c9bbdbe85",
          "name": "Get parse job status",
          "request": {
            "name": "Get parse job status",
            "description": {
              "content": "Retrieve the status and optionally the results of a parse job. Use the expand parameter to control what parsed content is returned, including text, markdown, structured JSON, or metadata. Poll this endpoint to check job completion status.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "parse",
                "jobs",
                ":jobId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "expand",
                  "value": "<string>",
                  "description": "Comma-separated list of result fields to include in the response. Controls whether text, markdown, structured JSON, or metadata is returned with the job status."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "jobId",
                  "description": "(Required) Unique identifier of the parse job."
                }
              ]
            },
            "header": [
